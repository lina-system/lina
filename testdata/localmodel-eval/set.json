{
  "version": 1,
  "note": "Fixed set for the short-task route. line is what the person typed; prompt is the exact input the caller sends and defaults to line. Dates are absolute so the model needs no clock. A schema of plain strings carries no vocabulary, so a prompt that needs one names it. Scoring compares date and time as calendar values and every other field as lower-case trimmed text. A case is correct when every check passes. Autocomplete checks the continuation stays on the task and stays short; they do not judge style.",
  "cases": [
    {
      "id": "intent-01",
      "kind": "intent",
      "line": "사파리 열어",
      "prompt": "Action must be one of: open_app, ask_agent, create_todo, search. Target is the app, agent, title or query the line names.\nLine: 사파리 열어",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string"
          },
          "target": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "target"
        ]
      },
      "expect": {
        "fields": {
          "action": "open_app"
        },
        "field_any": {
          "target": [
            "safari",
            "사파리"
          ]
        }
      }
    },
