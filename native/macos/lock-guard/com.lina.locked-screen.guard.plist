<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The lock guard. launchd starts it at load and whenever the plug-in folder
  changes; the daemon also passes over its state once a second.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lina.locked-screen.guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.lina.locked-screen.guard</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>WatchPaths</key>
	<array>
		<string>/Library/Security/SecurityAgentPlugins</string>
	</array>
</dict>
</plist>
