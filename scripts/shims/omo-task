#!/bin/sh
# omo-task -> lina worker, same verbs and options (lina#37). Written by `lina install --shims`;
# take its folder off PATH to go back to the old tool (docs/switch-callers.md).
: "${HERMES_HOME:=@LINA_HOME@}"
export HERMES_HOME
PYTHONPATH="@PYTHONPATH@" exec "@PYTHON@" -m hermes_cli.lina_shims omo-task "$@"
