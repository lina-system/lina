#!/usr/bin/env python3
"""hub client for LINA Helper: runs lina-helperctl on the agent Mac over SSH."""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys

CTL = '/Applications/LINA Helper.app/Contents/Helpers/lina-helperctl'
ACTIONS = ('status', 'permissions', 'screenshot', 'ax.tree', 'ax.press', 'input.click', 'input.keys', 'app.open')
HOST_RE = r'[A-Za-z0-9][A-Za-z0-9_.-]{0,127}'
KEY_RE = r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}'
# Same ceiling as lina-helperctl's response frame (app Transport.responseLimit).
MAX_JSON = 128 << 20
TIMEOUT = 30
SCREENSHOT_TIMEOUT = 45


class UsageError(ValueError):
    pass


def failure(code, detail=None):
    error = {'code': code}
    if detail:
        error['detail'] = detail
    return {'v': 1, 'ok': False, 'error': error}


def command(host, action, args=(), out=False, json_args=None):
    if not re.fullmatch(HOST_RE, host or ''):
        raise UsageError('host must be a configured SSH alias or hostname')
    if action not in ACTIONS:
        raise UsageError('unsupported action')
    if out and action != 'screenshot':
        raise UsageError('--out is only valid for screenshot')
    remote = [CTL, action]
    for item in args:
        key, sep, _ = item.partition('=')
        if not sep or not re.fullmatch(KEY_RE, key):
            raise UsageError('--arg must be k=v with a plain key')
        remote += ['--arg', item]
    if json_args is not None:
        try:
            value = json.loads(json_args)
        except ValueError:
            raise UsageError('--json must be a JSON object')
        if not isinstance(value, dict):
            raise UsageError('--json must be a JSON object')
        remote += ['--json', json.dumps(value, separators=(',', ':'), sort_keys=True)]
    if out:
        remote += ['--out', '-']
    return ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8', '-o', 'ServerAliveInterval=5',
            '-o', 'ServerAliveCountMax=2', host, shlex.join(remote)]


def parse_response(raw):
    if len(raw) > MAX_JSON:
        return None
    try:
        value = json.loads(raw)
    except (ValueError, UnicodeError):
        return None
    if not isinstance(value, dict) or value.get('v') != 1 or not isinstance(value.get('ok'), bool):
        return None
    return value


def invoke(host, action, args=(), out=None, runner=subprocess.run, json_args=None):
    """Return (exit_code, response dict). Never retries."""
    cmd = command(host, action, args, out is not None, json_args)
    if out is not None and os.path.lexists(out):
        raise UsageError('refusing to overwrite existing file')
    try:
        p = runner(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                   timeout=SCREENSHOT_TIMEOUT if action == 'screenshot' else TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        return 1, failure('transport_timeout')
    bad = (1, failure('invalid_remote_response'))
    if out is None:
        value = parse_response(p.stdout)
    else:
        value = parse_response(p.stderr.rstrip(b'\r\n').split(b'\n')[-1])
    if value is None:
        return bad
    if not value['ok']:
        return 1, value
    if p.returncode != 0:
        return bad
    if out is not None:
        if not p.stdout:
            return bad
        try:
            f = open(out, 'xb')
        except FileExistsError:
            raise UsageError('refusing to overwrite existing file')
        except OSError as e:
            return 1, failure('output_unwritable', e.strerror or str(e))
        try:
            with f:
                f.write(p.stdout)
        except OSError as e:
            try:
                os.unlink(out)
            except OSError:
                pass
            return 1, failure('output_unwritable', e.strerror or str(e))
    return 0, value


def main(argv=None, runner=subprocess.run, env=None, stdout=None):
    stdout = stdout or sys.stdout
    env = os.environ if env is None else env
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--host', default=env.get('LINA_HELPER_SSH_HOST'), help='SSH alias (default: $LINA_HELPER_SSH_HOST)')
    ap.add_argument('action')
    ap.add_argument('--arg', action='append', default=[], metavar='k=v')
    ap.add_argument('--json', metavar='OBJECT', help='typed arguments as one JSON object, e.g. {"depth":2}')
    ap.add_argument('--out', metavar='PATH', help='screenshot only: write the image bytes to PATH')
    ns = ap.parse_args(argv)
    try:
        code, value = invoke(ns.host, ns.action, ns.arg, ns.out, runner, ns.json)
    except UsageError as e:
        code, value = 1, failure('bad_request', str(e))
    print(json.dumps(value, sort_keys=True), file=stdout)
    return code


if __name__ == '__main__':
    raise SystemExit(main())
